rules_version = '2';

/* ============================================================
   HAYAT — FIRESTORE RULES

   Three kinds of visitor, three ways in:

     office    signs in with Google. A document must exist at
               staff/<their uid> with  role: "office".
               That document can only be made in this console,
               so nobody can promote themselves.

     rider     signs in silently (anonymous), then proves a
               6-digit code against their own record. The code
               is never readable — the rules compare what the
               rider typed with what is stored, and only on a
               match stamp that phone onto the record.

     customer  signs in silently (anonymous). No password, no
               code. They may open and track only their own
               orders.

   A rider record's document id IS the phone number, digits
   only, e.g. riders/919844326842 — so a rider can address
   their own record without being able to list anyone else's.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOffice() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == "office";
    }
    /* crew roles: office, captain, kitchen, cleaner, waiter (from the crew code they signed in with) */
    function isCrew() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function hasRole(roles) {
      return isCrew() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in roles;
    }
    function mine() {
      return request.auth.uid;
    }
    /* the keys this write is actually changing */
    function touching() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* ---- the menus -----------------------------------------
       There can be many: the everyday one, a Ramadan one, a
       draft being built. Each is a single document holding the
       whole card, so a customer's phone reads one document and
       not a hundred.

         menus/_active        points at the one customers see
         menus/<id>           a whole menu, live or draft

       Drafts are readable by anyone who has the test link. A
       menu is not a secret; the point of the link is to look
       at it on a real phone before it goes live. */
    match /menus/{doc} {
      allow read:  if true;
      allow write: if isOffice();
    }

    /* ---- proving a number on a new phone --------------------
       A customer may ask, and may offer a code back. They may
       never read the document, so they cannot read the code they
       are supposed to be guessing. The office does the approving,
       and the office is what links the orders afterwards - which
       is why nothing here grants a customer any new read. */
    match /verify/{phone} {
      allow get, list: if isOffice();

      allow create: if signedIn()
        && request.resource.data.uid == mine()
        && request.resource.data.ok == false
        && request.resource.data.code == null;

      allow update: if isOffice()
        /* or the customer offering a code, and nothing else */
        || (
          signedIn()
          && resource.data.uid == mine()
          && touching().hasOnly(['codeTry','triedAt'])
        );

      allow delete: if isOffice()
        || (signedIn() && resource.data.uid == mine());
    }

    /* ---- the customer book ---------------------------------
       Names, addresses and doorsteps. The most sensitive thing
       this database holds, so only the office may read it at
       all - not riders, and certainly not customers. A rider
       learns a doorstep by delivering to it; they write that
       through the order, never here. */
    match /customers/{phone} {
      allow read:  if isOffice();
      allow write: if isOffice();
    }

    /* ---- riders --------------------------------------------
       Document id is the phone, digits only.

       A rider claims their own record by sending the code they
       were given. They cannot read the record first, so the
       code cannot be looked up — only guessed, and six digits
       is a million guesses. */
    match /riders/{phone} {

      allow get:    if isOffice() || (signedIn() && resource.data.uid == mine());
      allow list:   if isOffice();
      allow create: if isOffice();
      allow delete: if isOffice();

      allow update: if isOffice()
        || (
          signedIn()
          && touching().hasOnly(['uid', 'codeTry', 'claimedAt'])
          && request.resource.data.codeTry == resource.data.code
          && request.resource.data.uid == mine()
        );
    }

    /* ---- orders --------------------------------------------
       A customer places an order and follows their own.
       A rider sees the deliveries stamped with their phone.
       The office sees everything.

       Order ids carry a random suffix, so knowing one order
       number tells you nothing about the next. */
    match /orders/{id} {

      allow get: if true;

      allow list: if isOffice()
        || (signedIn() && resource.data.custUid  == mine())
        || (signedIn() && resource.data.riderUid == mine());

      allow create: if signedIn()
        && request.resource.data.status == "placed"
        && request.resource.data.custUid == mine()
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() < 100;

      /* the customer may only cancel, and only before it moves */
      allow update: if isOffice()
        || (
          signedIn() && resource.data.riderUid == mine()
          && touching().hasOnly(['status','rLat','rLng','rAt','at','log','notes'])
        )
        || (
          signedIn() && resource.data.custUid == mine()
          && touching().hasOnly(['status','at','log','cancelBy','cancelWhy','notes'])
          && request.resource.data.status == 'cancelled'
          && resource.data.status in ['placed','accepted']
        )
        /* anyone on this order may add to the thread, and only
           add: the list may grow, never shrink, so no one can
           quietly delete what was said */
        || (
          signedIn()
          && (resource.data.custUid == mine() || resource.data.riderUid == mine())
          && touching().hasOnly(['notes'])
          && request.resource.data.notes.size() > resource.data.notes.size()
        );

      allow delete: if isOffice();
    }

    /* ---- the crew ------------------------------------------
       Signing in to the office is: pick your name, type your
       code. No email, no password to forget.

         crew/_list          just the names, for the dropdown
         crew/<id>           { name, code, role }  never readable

       The code is never sent to the browser. A sign-in is an
       attempt to create your own staff record, and the rules
       accept it only if the code you typed matches the one
       stored beside your name. The comparison happens here,
       where nobody can look at the answer.

       Set each person's code in the console. Four digits is
       ten thousand guesses and a script can try them all;
       six is a million. The office can change prices and read
       every customer's address, so six is the sensible length. */
    match /crew/{id} {
      allow read:  if id == "_list";
      allow write: if isOffice();          /* the office hands out codes from the cleaning page */
    }

    /* ---- who you are, once you have proved it --------------
       You may create your own record, and only by presenting a
       code that matches a crew entry. You may never change it
       afterwards, and never touch anybody else's. */
    match /staff/{uid} {
      allow read:   if signedIn() && uid == mine();
      allow create: if signedIn() && uid == mine()
        && exists(/databases/$(database)/documents/crew/$(request.resource.data.crew))
        && request.resource.data.code ==
             get(/databases/$(database)/documents/crew/$(request.resource.data.crew)).data.code
        && request.resource.data.role ==
             get(/databases/$(database)/documents/crew/$(request.resource.data.crew)).data.role;
      allow update, delete: if false;
    }

    /* ---- the busy bars the crowd robot reads -----------------
       Written by a phone that stays at the shop, one document per
       place. It carries no login - it is a phone in a drawer - so
       instead it carries a word, and the word has to match the
       one written here. Change ROBOT_WORD to something of your
       own and type the same thing into the app. Anybody may read
       the bars; they are public on Google anyway. */
    match /crowd/{place} {
      allow read:  if true;
      allow write: if request.resource.data.robot == "ROBOT_WORD"
                   && request.resource.data.robot != "";
    }

    /* the phone's last-seen pings: a customer writes their own,
       the office reads them and moves them into the book */
    match /pings/{phone} {
      allow read:  if isOffice();
      allow write: if true;
    }

    /* ---- the VMENU copy -------------------------------------
       Written only by the sync service on the shop PC, which uses
       a Firebase admin key and so is not bound by these rules.
       Bills carry amounts and staff names: office eyes only.

         vm_bills/{invoiceid}   settled bills, items inside
         vm_open/{id}           tables still eating
         vm_days/{YYYY-MM-DD}   one summary per business day
         vm_staff/{id}          names, each a waiter or a service agent
         vm_meta/sync           when the service last ran            */
    match /vm_bills/{id} { allow read: if isOffice(); allow write: if false; }
    match /vm_open/{id}  { allow read: if isOffice() || hasRole(['kitchen','captain']); allow write: if false; }
    match /vm_days/{id}  { allow read: if isOffice(); allow write: if false; }
    match /vm_staff/{id} { allow read: if isOffice(); allow write: if false; }
    match /vm_meta/{id}  { allow read: if isCrew(); allow write: if false; }

    /* ---- kitchen screens and the waitlist ---------------------
         kds/{screen_invoice_round}  when a kitchen marked a KOT done
         waitlist/{id}               guests waiting (phone deleted after 7 days) */
    match /kds/{id}      { allow read, write: if isOffice() || hasRole(['kitchen','captain']); }
    match /waitlist/{id} { allow read, write: if isOffice() || hasRole(['captain']); }

    /* ---- cleaning -------------------------------------------
         cleanplan/main      the master cleaning schedule (office edits)
         cleanlog/{id}       one tick per task done: who, when, optional small photo
         pushtok/{uid}       this phone's reminder token */
    match /cleanplan/{id} { allow read: if isCrew(); allow write: if isOffice(); }
    match /cleanlog/{id} {
      allow read:   if isCrew();
      allow create: if isCrew() && request.resource.data.uid == request.auth.uid
                    && (!('photo' in request.resource.data) || request.resource.data.photo == null || request.resource.data.photo.size() < 90000);
      allow update: if isOffice() || hasRole(['captain']);        /* verify / reject */
      allow delete: if isOffice() || (isCrew() && resource.data.uid == request.auth.uid);
    }
    match /pushtok/{uid} {
      allow read:  if isOffice();
      allow write: if isCrew() && uid == request.auth.uid;
    }

    /* ---- everything else is closed -------------------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
