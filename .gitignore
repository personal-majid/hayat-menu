# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# python
__pycache__/
*.pyc

# build output (regenerate with the zip step)
*.zip

# local test servers / scratch
.cache/

# scratch test scripts
*.mjs

Claude outputs/

# local VMENU sync service: secrets and local data stay on the shop PC
local-service/config.ini
local-service/firebase-key.json
local-service/*.json.key
local-service/cache.db
local-service/logs/
local-service/.venv/
local-service/discover_report.txt

# day logs and probes hold customer names, phones, addresses: never in git
local-service/daylog/
local-service/*.bak
local-service/publish_state.json
local-service/probe_report.txt
local-service/probe_today.txt
local-service/print_agent.log*

# node tooling for tests/ — the site is served from this folder,
# so anything here goes to the website. Never ship these.
node_modules/
package.json
package-lock.json
.firebase/
firebase-debug.log
firestore-debug.log
rules-run.log
